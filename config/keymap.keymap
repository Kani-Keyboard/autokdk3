
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings =<
                &kp Q   &kp W   &kp E    &kp R    &kp T                                   &kp Y           &kp U      &kp I      &kp O      &kp P
				&kp A   &kp S   &kp D    &kp F    &kp G     &kp ESC       &kp DEL         &kp H           &kp J      &kp K      &kp L      &kp MINUS
				&kp Z   &kp X   &kp C    &kp V    &kp B     &kp TAB       &kp BSPC        &kp N           &kp M      &kp COMMA  &kp DOT    &kp DOT
				                         &kp LWIN &kp LANG2 &kp SPACE     &kp ENTER $mo 2 &kp LANG1 $mo 1
            >;
        };

        layer_1 {
            bindings =<
                &kp Q   &kp W   &kp E    &kp R    &kp T                                   &kp A           &kp U      &kp I      &kp O      &kp P
				&kp A   &kp S   &kp D    &kp F    &kp G     &kp ESC       &kp DEL         &kp A           &kp J      &kp K      &kp L      &kp MINUS
				&kp Z   &kp X   &kp C    &kp V    &kp B     &kp TAB       &kp BSPC        &kp A           &kp M      &kp COMMA  &kp DOT    &kp DOT
				                         &kp LWIN &kp LANG2 &kp SPACE     &kp ENTER       &kp LANG1
            >;
        };

        layer_2 {
            bindings =<
                &none &none &none &none &none &none &none &none &none &none
				&none &none &none &none &none &none &none &none &none &none &none &none
				&none &none &none &none &none &none &none &none &none &none &none &none
				&none &none &none &none &none
            >;
        };

        layer_3 {
            bindings =<
                &none &none &none &none &none &none &none &none &none &none
				&none &none &none &none &none &none &none &none &none &none &none &none
				&none &none &none &none &none &none &none &none &none &none &none &none
				&none &none &none &none &none
            >;
        };
    };
};
