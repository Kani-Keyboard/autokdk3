
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings =<
                &kp Q         &kp W        &kp E    &kp R        &kp T                                           &kp Y           &kp U      &kp I      &kp O        &kp P
				&lt LSHFT A   &kp S        &kp D    &kp F        &kp G           &kp ESC         &kp DEL         &kp H           &kp J      &kp K      &kp L        &lt LSHFT MINUS
				&lt LCTRL Z   &lt LALT X   &kp C    &kp V        &kp B           &kp TAB         &kp BSPC        &kp N           &kp M      &kp COMMA  &lt LALT DOT &lt LCTRL QMARK
				                           &kp LWIN &lt 3 LANG2  &lt 3  SPACE    &lt 2 ENTER     &lt 1 LANG1
            >;
        };

        layer_1 {
            bindings =<
                &kp DQT   &kp HASH  &kp DOLLAR  &kp APERCENT &kp AMPS                            &kp LPAR       &kp RPAR   &kp COLON  &kp BSLH      &kp SLASH
				&kp GRAVE &kp APOS  &kp INT3    &kp CARET    &kp PIPE  &kp AT        &kp ASTRK   &kp LBRC       &kp RBRC   &kp SEMI   &kp KP_EQUAL  &kp UNDER
				&none     &none     &kp LT      &none        &kp GT    &kp TILDE     &kp PLUS    &kp LBKT       &kp RBKT   &kp COMMA  &kp DOT       &kp EXCL
				                                &none        &none     &none         &none       &none
            >;
        };

        layer_2 {
            bindings =<
                &none &none &none &none &none &none &none &none &none &none
				&none &none &none &none &none &none &none &none &none &none &none &none
				&none &none &none &none &none &none &none &none &none &none &none &none
				&none &none &none &none &none
            >;
        };

        layer_3 {
            bindings =<
                &none &none &none &none &none &none &none &none &none &none
				&none &none &none &none &none &none &none &none &none &none &none &none
				&none &none &none &none &none &none &none &none &none &none &none &none
				&none &none &none &none &none
            >;
        };
    };
};
