
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {

/* ==================== コンボ設定ここから ==================== */
    combos {
        compatible = "zmk,combos";
        
        // 【Win + F】で Win + ↑ (画面最大化など)
        combo_win_up {
            timeout-ms = <50>;
            key-positions = <13 34>;       // F[13] と LWIN[34]
            bindings = <&kp LG(UP)>;
        };

        // 【Win + C】で Win + ← (画面を左にスナップ)
        combo_win_left {
            timeout-ms = <50>;
            key-positions = <24 34>;       // C[24] と LWIN[34]
            bindings = <&kp LG(LEFT)>;
        };

        // 【Win + B】で Win + → (画面を右にスナップ)
        combo_win_right {
            timeout-ms = <50>;
            key-positions = <26 34>;       // B[26] と LWIN[34]
            bindings = <&kp LG(RIGHT)>;
        };

        // 【Win + V】で Win + ↓ (画面最小化 / 元のサイズに戻す)
        combo_win_down {
            timeout-ms = <50>;
            key-positions = <25 34>;       // V[25] と LWIN[34]
            bindings = <&kp LG(DOWN)>;
        };
    };
    /* ==================== コンボ設定ここまで ==================== */

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings =<
                &kp Q         &kp W        &kp E     &kp R        &kp T                                  &kp Y      &kp U      &kp I      &kp O        &kp P
				&mt LSHFT A   &kp S        &kp D     &kp F        &kp G        &kp ESC      &kp DEL      &kp H      &kp J      &kp K      &kp L        &lt LSHFT MINUS
				&mt LCTRL Z   &lt LALT X   &kp C     &kp V        &kp B        &kp TAB      &kp BSPC     &kp N      &kp M      &kp COMMA  &lt LALT DOT &lt LCTRL QMARK
				                           &kp LWIN  &lt 3 LANG2  &lt 3 SPACE  &lt 2 ENTER  &lt 1 LANG1
            >;
        };

        layer_1 {
            bindings =<
                &kp DQT       &kp HASH   &kp DOLLAR &kp PERCENT   &kp AMPS                               &kp LPAR  &kp RPAR   &kp COLON  &kp BSLH      &kp SLASH
				&kp GRAVE     &kp APOS   &kp INT3   &kp CARET     &kp PIPE     &kp AT      &kp ASTRK     &kp LBRC  &kp RBRC   &kp SEMI   &kp EQUAL     &kp UNDER
				&none         &none      &kp LT     &none         &kp GT       &kp TILDE   &kp PLUS      &kp LBKT  &kp RBKT   &kp COMMA  &kp DOT       &kp EXCL
				                                    &none         &none        &none       &none         &none
            >;
        };

        layer_2 {
            bindings =<
                &kp Q        &kp W       &kp E      &kp R        &kp T                                   &kp N7    &kp N8     &kp N9     &kp BSLH      &kp SLASH
				&kp A        &kp S       &kp D      &kp F        &kp G        &kp AT      &kp ASTRK      &kp N4    &kp N5     &kp N6     &kp EQUAL     &kp MINUS
				&kp Z        &kp X       &kp C      &kp V        &kp B        &kp TILDE   &kp PLUS       &kp N1    &kp N2     &kp N3     &kp DOT       &kp QMARK
				                                    &none         &none       &none       &none          &none
            >;
        };

        layer_3 {
            bindings =<
				&none        &none       &none       &none        &none                                   &kp F7   &kp F8      &kp F9    &kp F12        &kp F15
				&none       &none       &none       &kp UP       &none        &none       &none          &kp F4   &kp F5      &kp F6    &kp F11        &kp F14
				&none       &none       &kp LEFT    &kp DOWN     &kp RIGHT    &none       &none          &kp F1   &kp F2      &kp F3    &kp F10        &kp F13
                                                    &none        &none        &none       &none          &none
            >;
        };
    };
};

